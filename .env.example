# Copy this file to .env.local and fill in the values. .env.local is private and is never uploaded to GitHub.

# Google Gemini key (from https://aistudio.google.com/apikey). Used only by the server.
GEMINI_API_KEY=
# The Gemini model that reads the invoice photos. Change it here if Google retires this one.
GEMINI_MODEL=gemini-3.6-flash

# Supabase project URL and SECRET key (Project Settings > API Keys). Used only by the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
